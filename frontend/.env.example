# Supabase project settings (server-only; never prefix these with NEXT_PUBLIC_).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[SERVICE-ROLE-KEY]

# Required by the existing admin session implementation.
ADMIN_SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Used once by `npm run db:create-admin` after applying the SQL migration.
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-password

# Used only by `npm run db:migrate-mongo`. Remove after migration is verified.
MONGODB_URI=mongodb+srv://...
